{
  "name": "pitchside",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server shared tests docs README.md package.json tsconfig.json vite.config.ts index.html",
    "format:check": "prettier --check src server shared tests docs README.md package.json tsconfig.json vite.config.ts index.html",
    "test": "tsx --test tests/*.test.ts",
    "db:init": "tsx server/cli.ts db:init",
    "db:backup": "tsx server/cli.ts db:backup",
    "db:restore": "tsx server/cli.ts db:restore",
    "collect": "tsx server/cli.ts collect",
    "video:add": "tsx server/cli.ts video:add"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "cheerio": "^1.1.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
